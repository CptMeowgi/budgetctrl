{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Budget Ctrl",
  "version": "0.4.2",
  "identifier": "com.budget-ctrl.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Budget Ctrl",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "fullscreen": false,
        "decorations": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-background-timer-throttling --disable-renderer-backgrounding --disable-backgrounding-occluded-windows"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM2M0ExOEY1QkVGMjEzODUKUldTRkUvSys5Umc2TnRWc3Zmc1RTYmtDS2VZZG92MSt1YTE3WjJ2K0c2elRRdk5pdE16ZHRKMk8K",
      "endpoints": [
        "https://github.com/CptMeowgi/budgetctrl/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
